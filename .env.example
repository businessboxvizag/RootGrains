# Root Grains — environment variables
# Copy to .env for LOCAL testing only (.env is gitignored). For production,
# set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values.

# ── Razorpay (online payments) ───────────────────────────────────────────────
# Key ID is publishable (safe in the browser). Secret is server-only.
# Use rzp_test_… keys while testing, rzp_live_… for production.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx   # client (build-time)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx        # server (api/razorpay-order.js)
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx   # server ONLY — never expose

# ── Saardha delivery webhook (live order tracking) ───────────────────────────
# Full Firebase service-account JSON for kbr-app-9991a, on a single line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"kbr-app-9991a", ...}
# Shared secret; must match the ?token=… in the webhook URL registered with Saardha.
SARDHA_WEBHOOK_SECRET=choose-a-long-random-string
